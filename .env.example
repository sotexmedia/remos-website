# The public address of this website (for search engines and link previews).
# On Vercel this falls back to the project's production address.
NEXT_PUBLIC_SITE_URL=

# The Rem.os app. "Log In" links to <this>/login and is hidden until set.
NEXT_PUBLIC_APP_URL=https://app.example.com

# "Book a Demo": a scheduling link (Calendly, Cal.com, ...) if you have one,
# otherwise it emails NEXT_PUBLIC_CONTACT_EMAIL.
NEXT_PUBLIC_DEMO_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# "Get Started": a sign-up page once there is one; until then it does the
# same as "Book a Demo".
NEXT_PUBLIC_GET_STARTED_URL=

# Social profiles for the footer. Empty ones are hidden.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=
